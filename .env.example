# Copiar este archivo como .env y cambiar las contrasenas.
# .env no se sube a Git.

# Usuario que usa la replica para copiar los cambios de la principal
DB_REPLICATION_USER=replicador
DB_REPLICATION_PASSWORD=cambiar_esta_clave

# Contrasena de root en la replica
DB_REPLICA_ROOT_PASSWORD=cambiar_esta_clave

# Usuario de solo lectura para los microservicios
DB_LECTURA_USER=lectura
DB_LECTURA_PASSWORD=cambiar_esta_clave
